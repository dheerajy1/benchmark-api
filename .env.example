APP_PORT=change-me
APP_HEALTH_CLIENT_ID=change-me
APP_HEALTH_CLIENT_SECRET=change-me
DATABASE_URL=postgres://benchmark_api_service:<CHANGE_ME>@localhost:5432/benchmark_api_db
# Raw requests that name a path and a command are refused unless this is true (default: false)
ALLOW_CUSTOM_RUNS=false
# Absolute path of the JSON file that lists saved targets; leave empty for none
TARGETS_FILE=
